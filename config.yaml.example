database:
  host: 127.0.0.1
  port: 3306
  username: backup_user
  password: "secure_password"
  timeout: 30
  mydumper:
    enabled: true
    myloader:
      enabled: true
      threads: 4

backup:
  databases:
    - database1
  directory: /backups
  # check_last_backup_time: true   # Skip backup if run too soon
  # min_backup_interval: 1h        # Minimum interval between backups

upload:
  enabled: false
  destination: "remote:backup-folder"

logging:
  level: info
  format: clean

metrics:
  enabled: false
  port: "8080"

cleanup:
  enabled: false
  max_age_days: 7
