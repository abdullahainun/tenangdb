# TenangDB minimal config example.
# See docs/CONFIGURATION.md for all available options.

# MySQL (default when database.type is omitted, or set to "mysql")
database:
  type: mysql
  host: 127.0.0.1
  port: 3306
  username: backup_user
  password: "secure_password"
  timeout: 30
  mydumper:
    enabled: true
    myloader:
      enabled: true
      threads: 4

# PostgreSQL (set database.type to "postgresql")
# database:
#   type: postgresql
#   host: 127.0.0.1
#   port: 5432
#   username: backup_user
#   password: "secure_password"
#   timeout: 30

backup:
  databases:
    - database1
  directory: /backups
  # check_last_backup_time: true   # Skip backup if run too soon
  # min_backup_interval: 1h        # Minimum interval between backups

upload:
  enabled: false
  destination: "remote:backup-folder"
  # extra_flags: ["--gcs-bucket-policy-only"]  # For GCS uniform buckets

logging:
  level: info
  format: clean

metrics:
  enabled: false

cleanup:
  enabled: false
  max_age_days: 7
